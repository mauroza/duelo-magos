{
  "name": "duelo-magos",
  "version": "1.0.0",
  "description": "Servidor autoritativo para Duelo de Magos, un juego multijugador por rondas simultáneas, desplegado en Azure",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "contracts:validate": "tsx tools/validate-contracts.ts",
    "migrate": "node dist/infra/migrate-cli.js",
    "admin:promote": "tsx tools/promote-admin.ts",
    "bot": "tsx tools/bot.ts",
    "load": "tsx load/loadtest.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/keyvault-secrets": "^4.12.0",
    "@azure/monitor-opentelemetry": "^1.21.0",
    "@fastify/cors": "^11.4.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.9.1",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "ws": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
